$export "once" core {
  namespace std {
    type size_t = $__SIZE_T__;
  }
}

$export "once" mem {
  $import std.core;

  extern "C" fun malloc(std::size_t size) : dynamic;

  namespace std {
    error MemoryError {
      CannotAllocate
    }
    
    fun static malloc(size_t size) : !dynamic  {
      var dynamic m = @malloc(size);
      if (isnull m)
        return ::MemoryError::CannotAllocate;
      return m;
    }
  }

}
