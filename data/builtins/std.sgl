
$export "once" errors {
  namespace std {
    struct Err {
      string msg;
    }

    $generic<T> ErrOr {
      struct $self {
        variant($T value, Err err) v;
        boolean is_err;
        
        fun static Ok($T value) : Self {
          return {
            { .value = value },
            false
          };
        }

        fun static Err(Err error) : Self {
          return {
            { .err = error },
            true
          };
        }

      }
    }
  }
}

$export "once" core {
  namespace std {
    type size_t = $__SIZE_T__;
  }
}

$export "once" mem {
  $import std.core;
  $import std.errors;
  $cinclude("memory.h")

  namespace std {
    fun static malloc(size_t size) : $ErrOr<dynamic>  {
      var dynamic m = rawc { malloc(size) };
      if (isnull m)
        return std::$ErrOr<dynamic>::Err({"Cannot allocate memory"});
      return std::$ErrOr<dynamic>::Ok(m);
    }
  }

}
