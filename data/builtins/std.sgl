
$export "once" errors {
  namespace std {
    struct Err {
      string msg;
      int code;
    }

    $generic<T> ErrOr {
      struct $self {
        variant($T value, Err err) v;
        boolean is_err;
        
        fun static Ok($T value) : Self {
          return {
            { .value = value },
            false
          };
        }

        fun static Err(Err error) : Self {
          return {
            { .err = error },
            true
          };
        }

      }
    }

    fun readfile(string path) : $ErrOr<string> {

    }
  }
}
